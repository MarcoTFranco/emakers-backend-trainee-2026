# Copie este arquivo para .env e preencha com os dados reais.
# O arquivo .env NUNCA deve ser commitado no repositório.

# Credenciais do primeiro administrador da aplicação.
# Estas variáveis só têm efeito na primeira execução (quando não existe nenhum admin no banco).
ADMIN_EMAIL=admin@suaempresa.com
ADMIN_PASSWORD=troque_para_uma_senha_forte
ADMIN_CPF=000.000.000-00
ADMIN_NAME=Administrator
ADMIN_CEP=00000-000
